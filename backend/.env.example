# Example env for backend (development)
# Copy this file to .env and fill sensitive values. Do NOT commit .env to VCS.

# Port where the NestJS app will listen (matches docker-compose mapping)
PORT=3000

# PostgreSQL connection used by your application (these match docker-compose defaults)
POSTGRES_USER=admin
POSTGRES_PASSWORD=eventura_pwd
POSTGRES_DB=eventura_db
# If your app uses a full connection string instead of separate vars, use:
# DATABASE_URL=postgresql://admin:eventura_pwd@db:5432/eventura_db

# JWT secret for signing tokens (replace in prod with a strong secret)
JWT_SECRET=replace_with_a_strong_secret
